@using WhatsappComercial.Servicios.AutenticacionUsuario
@inject DialogService DialogService
@inject ObtenerNombreUsuario obtenerUsuario
@inherits LayoutComponentBase

<RadzenComponents @rendermode="InteractiveServer" />

<div class="page">
   @*  <div class="sidebar">
        <NavMenu />
    </div> *@

    <main>
        <div class="top-row px-4">
            <RadzenText Text="@nombreUsuarioDA"></RadzenText>
        </div>

        <article>
@*             content px-4 *@
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
	string nombreUsuarioDA = string.Empty;

	protected override void OnInitialized()
	{
        obtenerUsuario.ObtenerUsuarioActualAsync();
        nombreUsuarioDA = obtenerUsuario.NombreCompleto;
	}
}