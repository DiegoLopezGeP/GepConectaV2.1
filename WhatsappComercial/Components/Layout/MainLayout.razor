@using WhatsappComercial.Servicios.AutenticacionUsuario
@inject DialogService DialogService
@inject ObtenerNombreUsuario obtenerUsuario
@inherits LayoutComponentBase

<RadzenComponents @rendermode="InteractiveServer" />

<div class="layout-wrapper">
    <!-- CABECERA SUPERIOR (HEADER) -->
    <header class="app-header">
        
        <!-- SECCIÓN IZQUIERDA: LOGO Y MENÚ -->
        <div class="header-left">
            <div class="brand-container">
                <!-- Icono/Logo tipo GepConecta -->
                <div class="brand-icon">
                    <RadzenIcon Icon="chat" Style="font-size: 22px; color: white;" />
                </div>
                <span class="brand-name">GepConecta</span>
            </div>

@*             <!-- Botón Menú Hamburguesa -->
            <RadzenButton Icon="menu" 
                          Variant="Variant.Text" 
                          ButtonStyle="ButtonStyle.Base" 
                          class="btn-menu-toggle" /> *@
        </div>

        <!-- SECCIÓN DERECHA: NOTIFICACIONES Y PERFIL -->
        <div class="header-right">
            
            <!-- BOTÓN DE NOTIFICACIONES -->
            <div class="notif-wrapper">
@*                 <button class="notif-btn" @onclick="AbrirNotificaciones" title="Notificaciones">
                    <RadzenIcon Icon="notifications" Style="font-size: 20px; color: #475569;" />
                    @if (notificacionesNoLeidas > 0)
                    {
                        <span class="notif-badge">
                            @(notificacionesNoLeidas > 99 ? "99+" : notificacionesNoLeidas)
                        </span>
                    }
                </button> *@
            </div>

            <!-- PERFIL DEL USUARIO -->
            <div class="user-profile-btn">
                <!-- Avatar / Foto de perfil -->
                <div class="avatar-container">
                    <img src="@(!string.IsNullOrEmpty(fotoUsuario) ? fotoUsuario : "favicon.ico")" alt="Avatar" class="avatar-img" />
                </div>

                <!-- Info Usuario -->
                <div class="user-info">
                    <span class="user-name">@(string.IsNullOrEmpty(nombreUsuarioDA) ? "Diego Lopez" : nombreUsuarioDA)</span>
                    <span class="user-role">Asesor</span>
                </div>

                <!-- Flecha Desplegable -->
                <RadzenIcon Icon="expand_more" Style="font-size: 18px; color: #64748b;" />
            </div>

        </div>
    </header>

    <!-- ÁREA DE CONTENIDO DE LA PÁGINA -->
    <main class="app-body">
        @Body
    </main>
</div>

@code {
    string nombreUsuarioDA = string.Empty;
    string fotoUsuario = string.Empty;

    private int notificacionesNoLeidas = 2;

    protected override void OnInitialized()
    {
        try
        {
            obtenerUsuario.ObtenerUsuarioActualAsync();
            nombreUsuarioDA = obtenerUsuario.NombreCompleto;
            fotoUsuario = obtenerUsuario.FotoUsuario;
        }
        catch
        {
            // Fallback si no está cargado el servicio aún
        }
    }

    private void AbrirNotificaciones()
    {
        Console.WriteLine("Abrir panel de notificaciones");
    }
}
