@page "/login"
@layout Layout.EmptyLayout
@using Microsoft.AspNetCore.Authorization
@using Radzen
@using Radzen.Blazor
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión - WhatsApp Comercial</PageTitle>

<div class="login-page">
    <div class="login-wrapper">
        <RadzenCard class="login-card">

            <!-- Encabezado con Logo y Título -->
            <div class="login-header">
                <div class="logo-container">
                    <RadzenImage Path="favicon.png" AlternateText="Logo" class="logo-img" />
                </div>
                <h2 class="app-title">WhatsApp Comercial</h2>
                <p class="app-subtitle">Ingresa tus credenciales corporativas</p>
            </div>

            <!-- Alerta de Error -->
            @if (mostrarError)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger"
                             Variant="Variant.Flat"
                             Shade="Shade.Lighter"
                             AllowClose="false"
                             Icon="error_outline"
                             class="login-alert">
                    Usuario o contraseña incorrectos.
                </RadzenAlert>
            }

            <!-- Formulario Nativo HTML -->
            <form action="api/account/login" method="post" class="login-form">
                <AntiforgeryToken />

                <div class="form-group">
                    <RadzenFormField Text="Usuario de Red" Variant="Variant.Outlined" Style="width: 100%;">
                        <Start>
                            <RadzenIcon Icon="person_outline" class="field-icon" />
                        </Start>
                        <ChildContent>
                            <input type="text"
                                   name="username"
                                   class="custom-input"
                                   placeholder="Ej. diego.lopez"
                                   required
                                   autofocus
                                   autocomplete="username" />
                        </ChildContent>
                    </RadzenFormField>
                </div>

                <div class="form-group">
                    <RadzenFormField Text="Contraseña" Variant="Variant.Outlined" Style="width: 100%;">
                        <Start>
                            <RadzenIcon Icon="lock_open" class="field-icon" />
                        </Start>
                        <ChildContent>
                            <input type="password"
                                   name="password"
                                   class="custom-input"
                                   placeholder="••••••••"
                                   required
                                   autocomplete="current-password" />
                        </ChildContent>
                    </RadzenFormField>
                </div>

                <button type="submit" class="submit-btn">
                    <i class="rzi me-2">login</i> Iniciar Sesión
                </button>
            </form>

            <div class="login-footer">
                <span>Acceso Seguro • Active Directory GEP</span>
            </div>

        </RadzenCard>
    </div>
</div>

<style>
    /* Estructura Principal */
    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #101828 0%, #1d2939 50%, #0f172a 100%);
        padding: 1.5rem;
        box-sizing: border-box;
    }

    .login-wrapper {
        width: 100%;
        max-width: 420px;
        animation: fadeInScale 0.4s ease-out forwards;
    }

    /* Tarjeta del Login */
    .login-card {
        background: #ffffff !important;
        border-radius: 16px !important;
        padding: 2.5rem 2rem !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 8px 10px -6px rgba(0, 0, 0, 0.2) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

    /* Encabezado y Logo */
    .login-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .logo-container {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        background: #f0fdf4;
        border-radius: 50%;
        margin-bottom: 1rem;
        box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.1);
    }

    .logo-img {
        width: 44px;
        height: 44px;
        object-fit: contain;
    }

    .app-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 0.25rem 0;
        letter-spacing: -0.025em;
    }

    .app-subtitle {
        font-size: 0.875rem;
        color: #64748b;
        margin: 0;
    }

    /* Alerta */
    .login-alert {
        border-radius: 8px !important;
        font-size: 0.875rem;
        margin-bottom: 1.5rem !important;
    }

    /* Formularios e Inputs */
    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .form-group {
        width: 100%;
    }

    .field-icon {
        color: #64748b;
        font-size: 1.25rem;
    }

    .custom-input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.95rem;
        color: #0f172a;
        padding: 0.25rem 0;
    }

        .custom-input::placeholder {
            color: #94a3b8;
        }

    /* Botón de Enviar */
    .submit-btn {
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: #2563eb;
        color: #ffffff;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.85rem 1rem;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.25);
        margin-top: 0.5rem;
    }

        .submit-btn:hover {
            background-color: #1d4ed8;
            box-shadow: 0 6px 12px -2px rgba(37, 99, 235, 0.35);
            transform: translateY(-1px);
        }

        .submit-btn:active {
            transform: translateY(0);
            box-shadow: 0 2px 4px -1px rgba(37, 99, 235, 0.2);
        }

    /* Pie de página */
    .login-footer {
        margin-top: 2rem;
        text-align: center;
        font-size: 0.75rem;
        color: #94a3b8;
        border-top: 1px solid #f1f5f9;
        padding-top: 1rem;
    }

    /* Animación */
    @@keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(10px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    /* Ajustes para Pantallas Pequeñas */
    @@media (max-width: 480px) {
        .login-card {
            padding: 2rem 1.5rem !important;
            border-radius: 12px !important;
        }

        .app-title {
            font-size: 1.35rem;
        }
    }
</style>

@code {
    private bool mostrarError = false;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (uri.Query.Contains("error=true"))
        {
            mostrarError = true;
        }
    }
}