@using WhatsappComercial.Enums
@using WhatsappComercial.Interfaces.Contactos
@using WhatsappComercial.Modelos
@using WhatsappComercial.Modelos.DTOs

@inject IGuardarContacto guardarContacto
@inject IFormularioContactoService formularioService
@inject NotificationService notificationService
@inject DialogService dialogService

<RadzenCard class="rz-shadow-3 rz-border-radius-2 rz-p-4 rz-mx-auto" Style="max-width: 900px;">
    <!-- Encabezado -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-mb-4">
        <RadzenIcon Icon="person_add" IconStyle="IconStyle.Primary" Style="font-size: 2rem;" />
        <div>
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-m-0 rz-font-weight-bold">
                Registro de Contacto
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                Seleccione el tipo de perfil e ingrese los datos requeridos.
            </RadzenText>
        </div>
    </RadzenStack>

    <!-- Selector de Tipo -->
    <RadzenCard class="rz-background-color-base-100 rz-p-3 rz-mb-4" Variant="Variant.Flat">
        <RadzenText TextStyle="TextStyle.Overline" class="rz-display-block rz-mb-2">Tipo de Contacto</RadzenText>
        <RadzenSelectBar TValue="TipoContactoEnum"
                         Data="@tiposContacto"
                         TextProperty="Texto"
                         ValueProperty="Valor"
                         Value="@tipoContactoEnum"
                         ValueChanged="@OnTipoContactoChanged"
                         Style="width: 100%; flex-wrap: wrap;" />
    </RadzenCard>

    @if (camposEsquema.Any())
    {
        <RadzenTemplateForm TItem="Dictionary<string, object?>"
                            Data="@modeloDinamico"
                            Submit="OnSubmitContacto"
                            InvalidSubmit="OnInvalidSubmit">

            <RadzenRow RowGap="1.25rem" ColumnGap="1rem">
                <!-- Dropdown Beneficiarios -->
                @if (tipoContactoEnum == TipoContactoEnum.Beneficiario && beneficiariosEncontrados.Any())
                {
                    <RadzenColumn Size="12">
                        <RadzenFormField Text="Seleccione el Beneficiario de Afiliaciones *" Style="width: 100%;" Variant="Variant.Outlined">
                            <ChildContent>
                                <RadzenDropDown TValue="object"
                                                Data="@beneficiariosEncontrados"
                                                TextProperty="NombreContacto"
                                                ValueProperty="IdContacto"
                                                Value="@beneficiarioSeleccionadoId"
                                                ValueChanged="@OnBeneficiarioSeleccionado"
                                                Placeholder="-- Seleccione un beneficiario para autocompletar --" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                }

                <!-- Campos Dinámicos -->
                @foreach (var campo in camposEsquema)
                {
                    <RadzenColumn Size="12" SizeMD="@ObtenerAnchoColumna(campo)">
                        <RadzenFormField Text="@(campo.EsObligatorio ? $"{campo.Etiqueta} *" : campo.Etiqueta)"
                                         Style="width: 100%;"
                                         AllowFloatingLabel="false"
                                         Variant="Variant.Outlined">
                            <ChildContent>
                                @if (campo.TipoDato.IsEnum)
                                {
                                    <RadzenDropDown TValue="object"
                                                    Name="@campo.NombreCampo"
                                                    Data="@Enum.GetValues(campo.TipoDato)"
                                                    Value="@GetValor(campo.NombreCampo)"
                                                    ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                    @onkeydown="@(async (KeyboardEventArgs e) => await ManejarKeyDownCampoAsync(e, campo))" />
                                }
                                else if (campo.TipoDato == typeof(bool))
                                {
                                    <div class="rz-p-2 rz-display-flex rz-align-items-center">
                                        <RadzenCheckBox Name="@campo.NombreCampo"
                                                        TValue="bool"
                                                        Value="@GetValorBool(campo.NombreCampo)"
                                                        ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                        @onkeydown="@(async (KeyboardEventArgs e) => await ManejarKeyDownCampoAsync(e, campo))" />
                                        <RadzenLabel Text=" Confirmar / Activar" class="rz-ml-2" />
                                    </div>
                                }
                                else if (campo.TipoDato == typeof(DateTime) || campo.TipoDato == typeof(DateTime?))
                                {
                                    <RadzenDatePicker Name="@campo.NombreCampo"
                                                      DateFormat="dd/MM/yyyy"
                                                      TValue="DateTime?"
                                                      Value="@GetValorDateTime(campo.NombreCampo)"
                                                      ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                      @onkeydown="@(async (KeyboardEventArgs e) => await ManejarKeyDownCampoAsync(e, campo))" />
                                }
                                else if (campo.TipoDato == typeof(int) || campo.TipoDato == typeof(int?) ||
                                         campo.TipoDato == typeof(decimal) || campo.TipoDato == typeof(decimal?))
                                {
                                    <RadzenNumeric Name="@campo.NombreCampo"
                                                   TValue="decimal?"
                                                   Value="@GetValorDecimal(campo.NombreCampo)"
                                                   ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                   @onkeydown="@(async (KeyboardEventArgs e) => await ManejarKeyDownCampoAsync(e, campo))" />
                                }
                                else
                                {
                                    <RadzenTextBox Name="@campo.NombreCampo"
                                                   Value="@GetValorString(campo.NombreCampo)"
                                                   ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                   @onkeydown="@(async (KeyboardEventArgs e) => await ManejarKeyDownCampoAsync(e, campo))" />
                                }
                            </ChildContent>

                            <Helper>
                                @if (campo.EsObligatorio)
                                {
                                    <RadzenCustomValidator Component="@campo.NombreCampo"
                                                           Validator="@(() => ValidarCampoObligatorio(campo.NombreCampo))"
                                                           Text="@campo.MensajeError"
                                                           Popup="false" />
                                }
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                }
            </RadzenRow>

            <!-- Acciones -->
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem" class="rz-mt-4 rz-pt-3 rz-border-top">
                <RadzenButton Text="Cancelar" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Click="@(() => dialogService.Close(false))" />
                <RadzenButton Text="Guardar Contacto" Icon="save" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@isSaving" BusyText="Guardando..." />
            </RadzenStack>
        </RadzenTemplateForm>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" Variant="Variant.Flat" class="rz-mt-3">
            No se encontraron campos configurados para este tipo de contacto.
        </RadzenAlert>
    }
</RadzenCard>

@code {
    [Parameter] public GrupoUser? grupoUser { get; set; }

    private TipoContactoEnum tipoContactoEnum = TipoContactoEnum.Titular;
    private List<CampoEsquemaDTO> camposEsquema = new();
    private Dictionary<string, object?> modeloDinamico = new();
    private bool isSaving = false;

    private List<Contacto> beneficiariosEncontrados = new();
    private object? beneficiarioSeleccionadoId;
    private int? idClienteTitularLocal;

    private List<OpcionTipoContacto> tiposContacto = new();

    protected override void OnInitialized()
    {
        ConfigurarTiposContacto();
        CargarEsquema(tipoContactoEnum);
    }

    protected override void OnParametersSet()
    {
        ConfigurarTiposContacto();
    }

    private void ConfigurarTiposContacto()
    {
        if (grupoUser != null && grupoUser.IdGrupoTrabajo == 12)
        {
            tiposContacto = new List<OpcionTipoContacto>
            {
                new OpcionTipoContacto { Texto = "Relacionista", Valor = TipoContactoEnum.Relacionista }
            };

            if (tipoContactoEnum != TipoContactoEnum.Relacionista)
            {
                tipoContactoEnum = TipoContactoEnum.Relacionista;
                CargarEsquema(tipoContactoEnum);
            }
        }
        else
        {
            tiposContacto = new List<OpcionTipoContacto>
            {
                new OpcionTipoContacto { Texto = "Titular", Valor = TipoContactoEnum.Titular },
                new OpcionTipoContacto { Texto = "Beneficiario", Valor = TipoContactoEnum.Beneficiario },
                new OpcionTipoContacto { Texto = "Cobranzas", Valor = TipoContactoEnum.Cobranzas },
                new OpcionTipoContacto { Texto = "Pagadurías", Valor = TipoContactoEnum.Pagadurias },
                new OpcionTipoContacto { Texto = "Relacionista", Valor = TipoContactoEnum.Relacionista }
            };
        }
    }

    private void OnTipoContactoChanged(TipoContactoEnum nuevoTipo)
    {
        tipoContactoEnum = nuevoTipo;
        beneficiariosEncontrados.Clear();
        beneficiarioSeleccionadoId = null;
        CargarEsquema(nuevoTipo);
    }

    private void CargarEsquema(TipoContactoEnum tipo)
    {
        var res = formularioService.GenerarEsquema(tipo);
        camposEsquema = res.Campos;
        modeloDinamico = res.ModeloInicial;
    }

    private async Task ManejarKeyDownCampoAsync(KeyboardEventArgs e, CampoEsquemaDTO campo)
    {
        if (e.Key == "Enter" || e.Key == "Tab")
        {
            if (!campo.ValidarExistenciaOnBlur) return;

            var res = await formularioService.ProcesarValidacionBlurAsync(tipoContactoEnum, campo, modeloDinamico);

            if (!string.IsNullOrEmpty(res.Mensaje))
            {
                var severity = res.EsAdvertencia ? NotificationSeverity.Warning : NotificationSeverity.Success;
                notificationService.Notify(severity, res.Titulo, res.Mensaje, 5000);
            }

            if (res.BeneficiariosEncontrados != null)
            {
                beneficiariosEncontrados = res.BeneficiariosEncontrados;
                idClienteTitularLocal = res.IdClienteTitularLocal;
            }

            StateHasChanged();
        }
    }

    private void OnBeneficiarioSeleccionado(object idContacto)
    {
        beneficiarioSeleccionadoId = idContacto;

        formularioService.MapearBeneficiarioSeleccionado(
            idContacto,
            beneficiariosEncontrados,
            idClienteTitularLocal,
            modeloDinamico);

        notificationService.Notify(NotificationSeverity.Info, "Beneficiario Cargado", "Se autocompletaron los datos.");

        StateHasChanged();
    }

    private async Task OnSubmitContacto()
    {
        try
        {
            isSaving = true;
            await guardarContacto.GuardarContactoDinamicoAsync(tipoContactoEnum, modeloDinamico);
            notificationService.Notify(NotificationSeverity.Success, "Éxito", "El contacto fue registrado correctamente.");
            dialogService.Close(true);
        }
        catch (Exception ex)
        {
            notificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
        notificationService.Notify(NotificationSeverity.Warning, "Formulario Incompleto", "Por favor complete todos los campos obligatorios.");
    }

    private int ObtenerAnchoColumna(CampoEsquemaDTO campo) =>
        (campo.TipoDato == typeof(bool) || campo.NombreCampo.Contains("Observacion", StringComparison.OrdinalIgnoreCase) || campo.NombreCampo.Contains("Direccion", StringComparison.OrdinalIgnoreCase)) ? 12 : 6;

    private void SetValor(string key, object? val) => modeloDinamico[key] = val;
    private object? GetValor(string key) => modeloDinamico.TryGetValue(key, out var val) ? val : null;
    private string GetValorString(string key) => modeloDinamico.TryGetValue(key, out var val) ? val?.ToString() ?? "" : "";
    private decimal? GetValorDecimal(string key) => modeloDinamico.TryGetValue(key, out var val) && val != null ? Convert.ToDecimal(val) : null;
    private DateTime? GetValorDateTime(string key) => modeloDinamico.TryGetValue(key, out var val) && val is DateTime dt ? dt : null;
    private bool GetValorBool(string key) => modeloDinamico.TryGetValue(key, out var val) && val is bool b && b;

    private bool ValidarCampoObligatorio(string key)
    {
        if (!modeloDinamico.TryGetValue(key, out var val) || val == null) return false;
        if (val is string str) return !string.IsNullOrWhiteSpace(str);
        if (val is Enum enumVal) return Convert.ToInt32(enumVal) != 0;
        return true;
    }
}