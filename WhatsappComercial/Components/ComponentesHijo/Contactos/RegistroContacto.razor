@using WhatsappComercial.Enums
@using WhatsappComercial.Interfaces.Contactos
@using WhatsappComercial.Modelos
@using WhatsappComercial.Modelos.DTOs

@inject IGuardarContacto guardarContacto
@inject NotificationService notificationService

<div class="rz-p-0 rz-p-md-12">

    <RadzenTemplateForm TItem="Contacto"
                        Data="@contacto"
                        Submit="OnSubmitContacto"
                        InvalidSubmit="OnInvalidSubmit">

        <RadzenCard Style="width:100%; margin-bottom:10px;">
            <RadzenRadioButtonList TValue="TipoContactoEnum"
                                   Data="@tiposContacto"
                                   TextProperty="Texto"
                                   ValueProperty="Valor"
                                   @bind-Value="tipoContactoEnum" />
        </RadzenCard>

        <RadzenStack Gap="1rem">



            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Nombre Completo" Component="NombreContacto" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox Name="NombreContacto"
                                   @bind-Value="contacto.NombreContacto"
                                   Style="width:100%;" />

                    <RadzenRequiredValidator Component="NombreContacto"
                                             Text="El nombre es obligatorio." />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Celular" Component="CelularContacto" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox Name="CelularContacto"
                                   @bind-Value="contacto.CelularContacto"
                                   Style="width:100%;" />

                    <RadzenRequiredValidator Component="CelularContacto"
                                             Text="El celular es obligatorio." />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Identificación" Component="NombreContacto" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox Name="Identificacion"
                                   @bind-Value="contacto.Identificacion"
                                   Style="width:100%;" />

                    <RadzenRequiredValidator Component="Identificacion"
                                             Text="El celular es obligatorio." />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenLabel Text="Email" Component="NombreContacto" />
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenTextBox Name="CorreoElectronico"
                                   @bind-Value="contacto.CorreoElectronico"
                                   Style="width:100%;" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow>
                <RadzenColumn Size="12" class="rz-text-align-end">

                    <RadzenButton Text="Guardar"
                                  Icon="save"
                                  ButtonType="ButtonType.Submit"
                                  ButtonStyle="ButtonStyle.Primary" />

                </RadzenColumn>
            </RadzenRow>

        </RadzenStack>

    </RadzenTemplateForm>

</div>

@code {

    private Contacto contacto = new();
    private TipoContactoEnum tipoContactoEnum = TipoContactoEnum.Titular;
	private List<OpcionTipoContacto> tiposContacto = new()
	{
		new OpcionTipoContacto { Texto = "Titular", Valor = TipoContactoEnum.Titular },
		new OpcionTipoContacto { Texto = "Beneficiario", Valor = TipoContactoEnum.Beneficiario },
		new OpcionTipoContacto { Texto = "Cobranzas", Valor = TipoContactoEnum.Cobranzas },
        new OpcionTipoContacto { Texto = "Pagadurias", Valor = TipoContactoEnum.Pagadurias },
        new OpcionTipoContacto { Texto = "Relacionista", Valor = TipoContactoEnum.Relacionista }
	};

    private async Task OnSubmitContacto()
    {
        try
        {
            await guardarContacto.GuardarContactoAsync(contacto);

            notificationService.Notify(
                NotificationSeverity.Success,
                "Correcto",
                "El contacto fue registrado correctamente.");

            // Si deseas limpiar el formulario
            contacto = new Contacto();
        }
        catch (Exception ex)
        {
            notificationService.Notify(
                NotificationSeverity.Error,
                "Error",
                ex.Message);
        }
    }

    private void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
        notificationService.Notify(
            NotificationSeverity.Warning,
            "Formulario",
            "Complete los campos obligatorios.");
    }

}