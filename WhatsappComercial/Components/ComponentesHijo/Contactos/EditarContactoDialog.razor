@using WhatsappComercial.Enums
@using WhatsappComercial.Interfaces.Contactos
@using WhatsappComercial.Modelos
@using WhatsappComercial.Modelos.DTOs
@using System.Reflection

@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IBusquedaContactos ServicioContactos
@inject IFormularioContactoService FormularioService
@inject IActualizarContacto ActualizarContactoService

<style>
    /* Ajustes finos de presentación y alineación */
    .form-editar-container {
        max-width: 100%;
    }

    .custom-form-field .rz-form-field-content {
        background-color: var(--rz-body-background-color, #ffffff);
    }

    .checkbox-container {
        border: 1px solid var(--rz-border-color, #e0e0e0);
        border-radius: 6px;
        min-height: 48px;
        padding: 0 0.75rem;
        background-color: var(--rz-body-background-color, #ffffff);
    }
</style>

<RadzenStack Gap="1.25rem" Style="padding: 1.5rem;">

    <!-- Cabecera Limpia con Divider integrado -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-pb-2 rz-border-bottom">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <div class="rz-display-flex rz-align-items-center rz-justify-content-center rz-background-color-primary-lighter rz-border-radius-2" style="width: 40px; height: 40px;">
                <RadzenIcon Icon="edit_square" IconStyle="IconStyle.Primary" Style="font-size: 1.5rem;" />
            </div>
            <div>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0 rz-font-weight-bold">
                    Editar Contacto
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-subtle">
                    Actualice los campos del registro dinámico
                </RadzenText>
            </div>
        </RadzenStack>
    </RadzenStack>

    @if (isLoading)
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="rz-my-5">
            <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-3 rz-color-subtle">Cargando campos del formulario...</RadzenText>
        </RadzenStack>
    }
    else if (camposEsquema.Any())
    {
        <RadzenTemplateForm TItem="Dictionary<string, object?>" Data="@modeloDinamico" Submit="@Guardar" class="rz-p-0">
            <RadzenStack Gap="1.5rem">

                <!-- Rejilla de Campos -->
                <RadzenRow RowGap="1.25rem" ColumnGap="1rem">
                    @foreach (var campo in camposEsquema)
                    {
                        <RadzenColumn Size="12" SizeMD="@ObtenerAnchoColumna(campo)">

                            @if (campo.TipoDato == typeof(bool))
                            {
                                <!-- Caso especial: Checkbox estructurado igual que un FormField -->
                                <RadzenStack Gap="0.25rem">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-subtle rz-font-weight-bold">
                                        @(campo.EsObligatorio ? $"{campo.Etiqueta} *" : campo.Etiqueta)
                                    </RadzenText>
                                    <div class="rz-display-flex rz-align-items-center checkbox-container">
                                        <RadzenCheckBox Name="@campo.NombreCampo"
                                                        TValue="bool"
                                                        Value="@GetValorBool(campo.NombreCampo)"
                                                        ValueChanged="@(val => SetValor(campo.NombreCampo, val))" />
                                        <RadzenLabel Text="Confirmar / Activar" Component="@campo.NombreCampo" class="rz-ml-2 rz-m-0" Style="cursor: pointer;" />
                                    </div>
                                </RadzenStack>
                            }
                            else
                            {
                                <RadzenFormField Text="@(campo.EsObligatorio ? $"{campo.Etiqueta} *" : campo.Etiqueta)"
                                                 Variant="Variant.Outlined"
                                                 Class="custom-form-field"
                                                 Style="width: 100%;">
                                    <ChildContent>
                                        @if (campo.TipoDato.IsEnum)
                                        {
                                            <RadzenDropDown TValue="object"
                                                            Name="@campo.NombreCampo"
                                                            Data="@Enum.GetValues(campo.TipoDato)"
                                                            Value="@GetValor(campo.NombreCampo)"
                                                            ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                            Style="width: 100%;" />
                                        }
                                        else if (campo.TipoDato == typeof(DateTime) || campo.TipoDato == typeof(DateTime?))
                                        {
                                            <RadzenDatePicker Name="@campo.NombreCampo"
                                                              DateFormat="dd/MM/yyyy"
                                                              TValue="DateTime?"
                                                              Value="@GetValorDateTime(campo.NombreCampo)"
                                                              ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                              Style="width: 100%;" />
                                        }
                                        else if (campo.TipoDato == typeof(int) || campo.TipoDato == typeof(int?) ||
                                                 campo.TipoDato == typeof(decimal) || campo.TipoDato == typeof(decimal?))
                                        {
                                            <RadzenNumeric Name="@campo.NombreCampo"
                                                           TValue="decimal?"
                                                           Value="@GetValorDecimal(campo.NombreCampo)"
                                                           ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                           Style="width: 100%;" />
                                        }
                                        else
                                        {
                                            <RadzenTextBox Name="@campo.NombreCampo"
                                                           Value="@GetValorString(campo.NombreCampo)"
                                                           ValueChanged="@(val => SetValor(campo.NombreCampo, val))"
                                                           Style="width: 100%;" />
                                        }
                                    </ChildContent>
                                    <Start>
                                        <RadzenIcon Icon="@ObtenerIconoCampo(campo.NombreCampo)" />
                                    </Start>
                                    <Helper>
                                        @if (campo.EsObligatorio)
                                        {
                                            <RadzenCustomValidator Component="@campo.NombreCampo"
                                                                   Validator="@(() => ValidarCampoObligatorio(campo.NombreCampo))"
                                                                   Text="@campo.MensajeError"
                                                                   Popup="false" />
                                        }
                                    </Helper>
                                </RadzenFormField>
                            }
                        </RadzenColumn>
                    }
                </RadzenRow>

                <!-- Pie de página con Botones alineados y consistentes -->
                <RadzenStack Orientation="Orientation.Horizontal"
                             JustifyContent="JustifyContent.End"
                             AlignItems="AlignItems.Center"
                             Gap="0.75rem"
                             class="rz-pt-3 rz-mt-2 rz-border-top">

                    <RadzenButton Text="Cancelar"
                                  Icon="close"
                                  ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Flat"
                                  Shade="Shade.Lighter"
                                  Size="@(EsMovil ? ButtonSize.Small : ButtonSize.Medium)"
                                  Click="@(() => DialogService.Close(false))" />

                    <RadzenButton ButtonType="ButtonType.Submit"
                                  Text="Guardar Cambios"
                                  Icon="check"
                                  IsBusy="@isSaving"
                                  BusyText="Guardando..."
                                  ButtonStyle="ButtonStyle.Success"
                                  Shade="Shade.Lighter"
                                  Size="@(EsMovil ? ButtonSize.Small : ButtonSize.Medium)"
                                  Variant="Variant.Filled" />
                </RadzenStack>

            </RadzenStack>
        </RadzenTemplateForm>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" Variant="Variant.Flat" class="rz-m-0">
            No se encontraron campos configurados para este tipo de contacto.
        </RadzenAlert>
    }
</RadzenStack>

@code {
    [Parameter] public Contacto ContactoModel { get; set; } = new();
    [Parameter] public TipoContactoEnum TipoContacto { get; set; }
    [Parameter] public bool EsMovil { get; set; }

    private List<CampoEsquemaDTO> camposEsquema = new();
    private Dictionary<string, object?> modeloDinamico = new();
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnParametersSetAsync()
    {
        await CargarEsquemaYDatosAsync();
    }

    private async Task CargarEsquemaYDatosAsync()
    {
        isLoading = true;
        try
        {
            var res = FormularioService.GenerarEsquema(TipoContacto);
            camposEsquema = res.Campos;
            modeloDinamico = res.ModeloInicial ?? new Dictionary<string, object?>();

            if (ContactoModel != null)
            {
                var propiedades = ContactoModel.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance);

                foreach (var campo in camposEsquema)
                {
                    var prop = propiedades.FirstOrDefault(p => p.Name.Equals(campo.NombreCampo, StringComparison.OrdinalIgnoreCase));
                    if (prop != null && prop.CanRead)
                    {
                        var valor = prop.GetValue(ContactoModel);
                        modeloDinamico[campo.NombreCampo] = valor;
                    }
                }

                var propId = propiedades.FirstOrDefault(p =>
                    p.Name.Equals("IDContacto", StringComparison.OrdinalIgnoreCase) ||
                    p.Name.Equals("Id", StringComparison.OrdinalIgnoreCase) ||
                    p.Name.Equals("ID", StringComparison.OrdinalIgnoreCase));

                if (propId != null)
                {
                    var idValor = propId.GetValue(ContactoModel);
                    modeloDinamico["IDContacto"] = idValor;
                }
            }

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error al cargar datos", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Guardar(Dictionary<string, object?> model)
    {
        try
        {
            isSaving = true;

            await ActualizarContactoService.ActualizarContactoDinamicoAsync(TipoContacto, model);

            NotificationService.Notify(NotificationSeverity.Success, "Éxito", "El contacto fue actualizado correctamente.");
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(
                NotificationSeverity.Error,
                "Error al guardar",
                ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private int ObtenerAnchoColumna(CampoEsquemaDTO campo)
    {
        if (campo.TipoDato == typeof(bool) ||
            campo.NombreCampo.Contains("Nombre", StringComparison.OrdinalIgnoreCase) ||
            campo.NombreCampo.Contains("Correo", StringComparison.OrdinalIgnoreCase) ||
            campo.NombreCampo.Contains("Direccion", StringComparison.OrdinalIgnoreCase) ||
            campo.NombreCampo.Contains("Observacion", StringComparison.OrdinalIgnoreCase))
        {
            return 12;
        }
        return 6;
    }

    private string ObtenerIconoCampo(string nombreCampo) => nombreCampo.ToLower() switch
    {
        var n when n.Contains("nombre") => "person",
        var n when n.Contains("identificacion") || n.Contains("documento") || n.Contains("cedula") => "badge",
        var n when n.Contains("celular") || n.Contains("telefono") => "phone",
        var n when n.Contains("correo") || n.Contains("email") => "alternate_email",
        var n when n.Contains("fecha") => "calendar_today",
        _ => "edit"
    };

    private void SetValor(string key, object? val) => modeloDinamico[key] = val;
    private object? GetValor(string key) => modeloDinamico.TryGetValue(key, out var val) ? val : null;
    private string GetValorString(string key) => modeloDinamico.TryGetValue(key, out var val) ? val?.ToString() ?? "" : "";
    private decimal? GetValorDecimal(string key) => modeloDinamico.TryGetValue(key, out var val) && val != null ? Convert.ToDecimal(val) : null;
    private DateTime? GetValorDateTime(string key) => modeloDinamico.TryGetValue(key, out var val) && val is DateTime dt ? dt : null;
    private bool GetValorBool(string key) => modeloDinamico.TryGetValue(key, out var val) && val is bool b && b;

    private bool ValidarCampoObligatorio(string key)
    {
        if (!modeloDinamico.TryGetValue(key, out var val) || val == null) return false;
        if (val is string str) return !string.IsNullOrWhiteSpace(str);
        if (val is Enum enumVal) return Convert.ToInt32(enumVal) != 0;
        return true;
    }
}