@using System.IO
@using GepConecta.WhatsAppCloud.Models.Enums
@using GepConecta.WhatsAppCloud.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IWhatsAppCloudClient WhatsAppClient
@implements IDisposable
@inject IJSRuntime JS

<div class="contenedor-barra-mensaje">

	@* VISTA PREVIA DEL ARCHIVO ADJUNTADO *@
	@if (archivoSeleccionado != null && !grabandoAudio)
	{
		<div class="vista-previa-adjunto">
			<div class="info-adjunto">
				<RadzenIcon Icon="@ObtenerIconoArchivo(archivoSeleccionado.ContentType)" Style="font-size: 24px;" />
				<div class="detalles-archivo">
					<span class="nombre-archivo">@archivoSeleccionado.Name</span>
					<span class="tamano-archivo">@ObtenerTamanoLegible(archivoSeleccionado.Size)</span>
				</div>
			</div>
			<RadzenButton Icon="close"
						  Variant="Variant.Text"
						  ButtonStyle="ButtonStyle.Danger"
						  Size="ButtonSize.Small"
						  Click="QuitarArchivo" />
		</div>
	}

	<div class="barra-mensaje">

		@if (grabandoAudio)
		{
			@* MODO GRABACIÓN DE AUDIO (TIPO WHATSAPP) *@
			<div class="panel-grabacion">
				<RadzenButton Icon="delete"
							  Variant="Variant.Text"
							  ButtonStyle="ButtonStyle.Danger"
							  Click="CancelarGrabacion"
							  title="Descartar grabación" />

				<div class="indicador-grabacion">
					<span class="punto-rojo"></span>
					<span class="tiempo-grabacion">@tiempoGrabacion</span>
				</div>

				<RadzenButton Icon="send"
							  Variant="Variant.Filled"
							  ButtonStyle="ButtonStyle.Success"
							  Click="FinalizarYEnviarAudio"
							  title="Enviar audio" />
			</div>
		}
		else
		{
			@* MODO NORMAL DE TEXTO/ADJUNTO *@
			<div class="acciones-izquierda @(EsMovil ? "movil" : "")">

				<InputFile @ref="inputFile"
						   OnChange="OnInputFileChange"
						   style="display: none;"
						   id="fileInput"
						   accept="image/*,video/*,audio/*,application/pdf,.doc,.docx,.xls,.xlsx" />

				<RadzenButton Icon="attach_file"
							  Variant="Variant.Text"
							  ButtonStyle="ButtonStyle.Light"
							  Click="AbrirSelectorArchivos" />

				<RadzenButton Icon="mood"
							  Variant="Variant.Text"
							  ButtonStyle="ButtonStyle.Light"
							  Click="MostrarEmojis" />

			</div>

			<RadzenTextArea @bind-Value="mensaje"
							Placeholder="@(archivoSeleccionado != null ? "Añade un comentario..." : "Escribe un mensaje...")"
							Rows="2"
							Class="texto-mensaje" />

			@if (string.IsNullOrWhiteSpace(mensaje) && archivoSeleccionado == null)
			{
				<RadzenButton Icon="mic"
							  Variant="Variant.Text"
							  ButtonStyle="ButtonStyle.Info"
							  Click="GrabarAudio" />
			}
			else
			{
				<RadzenButton Icon="send"
							  Variant="Variant.Filled"
							  ButtonStyle="ButtonStyle.Primary"
							  Click="Enviar" />
			}
		}

	</div>
</div>

<style>
	.contenedor-barra-mensaje {
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 100%;
	}

	.vista-previa-adjunto {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: #f0f2f5;
		border-left: 4px solid #128c7e;
		padding: 8px 12px;
		border-radius: 8px;
		margin-bottom: 4px;
	}

	.info-adjunto {
		display: flex;
		align-items: center;
		gap: 10px;
		overflow: hidden;
	}

	.detalles-archivo {
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.nombre-archivo {
		font-size: 13px;
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 250px;
	}

	.tamano-archivo {
		font-size: 11px;
		color: #666;
	}

	.barra-mensaje {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.acciones-izquierda {
		display: flex;
		flex-direction: row;
		gap: 5px;
	}

		.acciones-izquierda.movil {
			flex-direction: column;
		}

	.texto-mensaje {
		flex: 1;
	}

		.texto-mensaje textarea {
			min-height: 45px;
			max-height: 150px;
			resize: none;
			border-radius: 20px;
			padding: 10px 15px;
		}

	/* ESTILOS DEL PANEL DE GRABACIÓN DE AUDIO */
	.panel-grabacion {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		background: #f0f2f5;
		border-radius: 25px;
		padding: 4px 12px;
	}

	.indicador-grabacion {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.punto-rojo {
		width: 12px;
		height: 12px;
		background-color: #ea4335;
		border-radius: 50%;
		animation: titilar 1s infinite alternate;
	}

	.tiempo-grabacion {
		font-weight: 600;
		font-size: 14px;
		color: #3b4a54;
		font-family: monospace;
	}

	@@keyframes titilar {
		0% {
			opacity: 1;
			transform: scale(1);
		}

		100% {
			opacity: 0.3;
			transform: scale(0.85);
		}
	}
</style>

@code {
	[Parameter] public bool EsMovil { get; set; }

	// EVENTOS SEPARADOS
	[Parameter] public EventCallback<(string, string)> OnEnviarTexto { get; set; }
	[Parameter] public EventCallback<(int, DatosAdjuntoOutDTO)> OnEnviarArchivo { get; set; }
	[Parameter] public int IdTicket { get; set; }

	// NÚMERO DE TELÉFONO DESTINO PARA WHATSAPP (Ej: "573001234567")
	[Parameter] public string TelefonoDestino { get; set; } = string.Empty;

	private string mensaje = string.Empty;
	private IBrowserFile? archivoSeleccionado;
	private InputFile? inputFile;

	// ESTADOS DE GRABACIÓN DE AUDIO
	private bool grabandoAudio = false;
	private string tiempoGrabacion = "00:00";
	private DotNetObjectReference<CuadroDeTexto>? objRef;

	protected override void OnInitialized()
	{
		objRef = DotNetObjectReference.Create(this);
	}

	private async Task AbrirSelectorArchivos()
	{
		await JS.InvokeVoidAsync("eval", "document.getElementById('fileInput').click()");
	}

	private void OnInputFileChange(InputFileChangeEventArgs e)
	{
		const long maxFileSize = 10 * 1024 * 1024; // 10 MB
		if (e.File.Size > maxFileSize)
		{
			Console.WriteLine("El archivo supera los 10MB autorizados.");
			return;
		}

		archivoSeleccionado = e.File;
		StateHasChanged();
	}

	private void QuitarArchivo()
	{
		archivoSeleccionado = null;
	}

	private async Task Enviar()
	{
		// CASO 1: Envío de Archivo Adjunto (con o sin comentario)
		if (archivoSeleccionado != null)
		{
			var datosAdjunto = new DatosAdjuntoOutDTO
			{
				Archivo = archivoSeleccionado,
				Comentario = mensaje
			};

			// 1. Convertir archivo a bytes
			using var stream = archivoSeleccionado.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
			using var ms = new MemoryStream();
			await stream.CopyToAsync(ms);
			byte[] bytesArchivo = ms.ToArray();

			// 2. Subir archivo a Meta
			if (!string.IsNullOrWhiteSpace(TelefonoDestino))
			{
				try
				{
					var uploadResult = await WhatsAppClient.UploadMediaAsync(
						fileBytes: bytesArchivo,
						fileName: archivoSeleccionado.Name,
						contentType: archivoSeleccionado.ContentType
					);

					if (uploadResult != null && !string.IsNullOrEmpty(uploadResult.Id))
					{
						string contentType = archivoSeleccionado.ContentType.ToLower();
						string mediaId = uploadResult.Id;

						// 3. Enviar según el MIME Type del archivo seleccionado
						if (contentType.StartsWith("audio/"))
						{
							// Nota: Meta no soporta caption/comentario en audios
							await WhatsAppClient.SendAudioAsync(TelefonoDestino, mediaId, isUrl: false);
						}
						else if (contentType.StartsWith("image/"))
						{
							await WhatsAppClient.SendImageAsync(TelefonoDestino, mediaId, caption: mensaje, isUrl: false);
						}
						else if (contentType.StartsWith("video/"))
						{
							await WhatsAppClient.SendVideoAsync(TelefonoDestino, mediaId, caption: mensaje, isUrl: false);
						}
						else
						{
							// Cualquier otro tipo (PDF, Excel, Word, Zip, etc.) se envía como documento
							await WhatsAppClient.SendDocumentAsync(
								to: TelefonoDestino,
								mediaIdOrUrl: mediaId,
								fileName: archivoSeleccionado.Name,
								caption: mensaje,
								isUrl: false
							);
						}

						Console.WriteLine($"[WHATSAPP]: Archivo {archivoSeleccionado.Name} enviado correctamente.");
					}
				}
				catch (Exception ex)
				{
					Console.WriteLine($"[WHATSAPP ERROR]: Error al enviar archivo: {ex.Message}");
				}
			}

			// Limpiar controles de UI
			mensaje = string.Empty;
			archivoSeleccionado = null;

			// Notificar al componente padre de Blazor (para guardar en BD local, refrescar chat, etc.)
			if (OnEnviarArchivo.HasDelegate)
			{
				await OnEnviarArchivo.InvokeAsync((IdTicket, datosAdjunto));
			}
			return;
		}

		// CASO 2: Envío exclusivo de Texto Plano
		if (!string.IsNullOrWhiteSpace(mensaje))
		{
			var textoAEnviar = mensaje;
			mensaje = string.Empty;
			string? waid = string.Empty;

			// 1. Enviar vía WhatsApp Cloud API
			if (!string.IsNullOrWhiteSpace(TelefonoDestino))
			{
				try
				{
					var respuestaWA = await WhatsAppClient.SendTextMessageAsync(
						TelefonoDestino,
						TipoMensajeWhatsAppEnum.text.ToString(),
						textoAEnviar
					);

					waid = respuestaWA?.Messages?.FirstOrDefault()?.Id;
					Console.WriteLine($"[WHATSAPP]: Mensaje de texto enviado. ID: {respuestaWA?.Messages?.FirstOrDefault()?.Id}");
				}
				catch (Exception ex)
				{
					Console.WriteLine($"[WHATSAPP ERROR]: {ex.Message}");
				}
			}

			// 2. Notificar al evento interno de Blazor
			if (OnEnviarTexto.HasDelegate)
			{
				await OnEnviarTexto.InvokeAsync((textoAEnviar, waid));
			}
		}
	}

	// LÓGICA DE GRABACIÓN DE AUDIO
	private async Task GrabarAudio()
	{
		bool ok = await JS.InvokeAsync<bool>("grabadorAudio.iniciar", objRef);
		if (ok)
		{
			grabandoAudio = true;
			tiempoGrabacion = "00:00";
		}
	}

	[JSInvokable]
	public void ActualizarTiempoJS(string tiempo)
	{
		tiempoGrabacion = tiempo;
		StateHasChanged();
	}

	private async Task CancelarGrabacion()
	{
		grabandoAudio = false;
		await JS.InvokeVoidAsync("grabadorAudio.cancelar");
	}

	private async Task FinalizarYEnviarAudio()
	{
		try
		{
			grabandoAudio = false;

			using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));

			ResultadoGrabacion? resultado;
			try
			{
				resultado = await JS.InvokeAsync<ResultadoGrabacion>(
					"grabadorAudio.detenerYObtenerData",
					cts.Token);
			}
			catch (TaskCanceledException)
			{
				Console.WriteLine("[AUDIO]: Tiempo de espera agotado al detener la grabación.");
				return;
			}

			if (resultado == null || resultado.Tamano == 0)
			{
				Console.WriteLine("[AUDIO]: No se obtuvieron datos de audio.");
				return;
			}

			// Obtenemos el stream de audio del JS
			var streamRef = await JS.InvokeAsync<IJSStreamReference>("grabadorAudio.obtenerStreamAudio");

			await using Stream stream = await streamRef.OpenReadStreamAsync(
				maxAllowedSize: 20 * 1024 * 1024,
				cancellationToken: cts.Token);

			using var memoryStream = new MemoryStream();
			await stream.CopyToAsync(memoryStream, cts.Token);
			byte[] bytesAudio = memoryStream.ToArray();

			// ---------------------------------------------------------------------------------------
			// APLICACIÓN DE LA OPCIÓN 2: Determinar extensión válida sin fallback a .webm
			// ---------------------------------------------------------------------------------------
			string contentType = resultado.ContentType?.ToLower().Trim() ?? "audio/ogg";

			// Mapeamos el tipo MIME recibido a una extensión compatible con Meta y con tu reproductor
			string extension = contentType switch
			{
				var c when c.Contains("mp4") => ".mp4",
				var c when c.Contains("aac") => ".aac",
				_ => ".ogg" // Forzamos OGG por defecto para notas de voz
			};

			// Aseguramos que el contentType que va a Meta sea un MIMEType limpio de la Cloud API
			string contentTypeMeta = extension switch
			{
				".mp4" => "audio/mp4",
				".aac" => "audio/aac",
				_ => "audio/ogg"
			};

			string nombreArchivo = $"{IdTicket}_audio_note_{DateTime.Now:yyyyMMdd_HHmmss}{extension}";
			// ---------------------------------------------------------------------------------------

			// 1. SUBIR AUDIO A META Y ENVIAR A WHATSAPP
			if (!string.IsNullOrWhiteSpace(TelefonoDestino))
			{
				try
				{
					// Subir nota de voz (.ogg / .mp4 / .aac)
					var uploadResult = await WhatsAppClient.UploadMediaAsync(
						fileBytes: bytesAudio,
						fileName: nombreArchivo,
						contentType: contentTypeMeta
					);

					if (uploadResult != null && !string.IsNullOrEmpty(uploadResult.Id))
					{
						// Enviar mensaje de audio
						var respuestaWA = await WhatsAppClient.SendAudioAsync(
							to: TelefonoDestino,
							mediaIdOrUrl: uploadResult.Id,
							isUrl: false
						);

						Console.WriteLine($"[WHATSAPP]: Nota de voz enviada. ID: {respuestaWA?.Messages?.FirstOrDefault()?.Id}");
					}
				}
				catch (Exception ex)
				{
					Console.WriteLine($"[WHATSAPP AUDIO ERROR]: {ex.Message}");
				}
			}

			// 2. CREAR OBJETO PARA USO LOCAL EN BLAZOR (BD / CHAT UI)
			IBrowserFile audioBrowserFile = new MemoryBrowserFile(
				nombreArchivo,
				bytesAudio,
				contentTypeMeta
			);

			var datosAdjunto = new DatosAdjuntoOutDTO
			{
				Archivo = audioBrowserFile,
				Comentario = string.Empty
			};

			if (OnEnviarArchivo.HasDelegate)
			{
				await OnEnviarArchivo.InvokeAsync((IdTicket, datosAdjunto));
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"[ERROR ENVIAR AUDIO]: {ex.Message}");
		}
	}

	private string ObtenerIconoArchivo(string contentType)
	{
		if (contentType.StartsWith("image/")) return "image";
		if (contentType.StartsWith("video/")) return "videocam";
		if (contentType.StartsWith("audio/")) return "audiotrack";
		if (contentType.Contains("pdf")) return "picture_as_pdf";
		return "insert_drive_file";
	}

	private string ObtenerTamanoLegible(long bytes)
	{
		string[] sufijos = { "B", "KB", "MB", "GB" };
		int i = 0;
		double dblSuf = bytes;

		while (bytes >= 1024 && i < sufijos.Length - 1)
		{
			i++;
			bytes /= 1024;
			dblSuf /= 1024;
		}

		return $"{dblSuf:0.##} {sufijos[i]}";
	}

	private async Task MostrarEmojis() { }

	public void Dispose()
	{
		objRef?.Dispose();
	}

	// CLASES DTO / WRAPPERS AUXILIARES
	public class DatosAdjuntoOutDTO
	{
		public required IBrowserFile Archivo { get; set; }
		public string Comentario { get; set; } = string.Empty;
	}

	public class ResultadoGrabacion
	{
		public string ContentType { get; set; } = string.Empty;
		public long Tamano { get; set; }
	}

	// Wrapper para convertir los bytes del micrófono a un IBrowserFile compatible
	public class MemoryBrowserFile : IBrowserFile
	{
		private readonly byte[] _bytes;
		public MemoryBrowserFile(string name, byte[] bytes, string contentType)
		{
			Name = name;
			_bytes = bytes;
			ContentType = contentType;
			Size = bytes.Length;
			LastModified = DateTimeOffset.Now;
		}

		public string Name { get; }
		public DateTimeOffset LastModified { get; }
		public long Size { get; }
		public string ContentType { get; }

		public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken cancellationToken = default)
		{
			return new MemoryStream(_bytes);
		}
	}
}