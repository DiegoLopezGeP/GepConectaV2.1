<RadzenCard class="contenedor-chat">

	<div class="lista-mensajes">

        @{
            DateTime? ultimoDia = null;
        }

        @foreach (var mensaje in Mensajes.OrderBy(m => m.Fecha))
        {
            if (ultimoDia != mensaje.Fecha.Date)
            {
                ultimoDia = mensaje.Fecha.Date;

                <div class="separador-fecha">
                    @ObtenerTextoFecha(mensaje.Fecha)
                </div>
            }

            <div class="@(mensaje.EsEntrante ? "mensaje-entrante" : "mensaje-saliente")">

                <div class="burbuja">

                    <div class="texto">
                        @mensaje.Texto
                    </div>

                    <div class="hora">
                        @mensaje.Fecha.ToString("hh:mm tt")
                    </div>

                </div>

            </div>
        }

	</div>

</RadzenCard>
<style>
	.contenedor-chat {
		height: 55vh;
		padding: 15px;
		border-radius: 12px;
		overflow: hidden;
	}

	.lista-mensajes {
		display: flex;
		flex-direction: column;
		gap: 10px;
		height: 100%;
		overflow-y: auto;
	}

	.mensaje-entrante {
		display: flex;
		justify-content: flex-start;
	}

	.mensaje-saliente {
		display: flex;
		justify-content: flex-end;
	}

	.burbuja {
		max-width: 70%;
		padding: 10px 14px;
		border-radius: 16px;
		word-break: break-word;
		position: relative;
	}

	.mensaje-entrante .burbuja {
		background: #f1f1f1;
		color: #222;
		border-bottom-left-radius: 4px;
	}

	.mensaje-saliente .burbuja {
		background: #d9fdd3;
		color: #222;
		border-bottom-right-radius: 4px;
	}

	.texto {
		white-space: pre-wrap;
	}

	.hora {
		margin-top: 6px;
		text-align: right;
		font-size: 11px;
		color: #777;
	}
    .separador-fecha {
        align-self: center;
        background: #e9edef;
        color: #54656f;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        margin: 10px 0;
        box-shadow: 0 1px 2px rgba(0,0,0,.08);
    }
</style>
