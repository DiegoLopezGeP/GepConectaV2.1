    private string ObtenerTextoFecha(DateTime fecha)
    {
        var hoy = DateTime.Today;
        var dia = fecha.Date;

        if (dia == hoy)
            return "Hoy";

        if (dia == hoy.AddDays(-1))
            return "Ayer";

        if (dia >= hoy.AddDays(-7))
            return fecha.ToString("dddd");

        return fecha.ToString("dd 'de' MMMM 'de' yyyy");
    }

