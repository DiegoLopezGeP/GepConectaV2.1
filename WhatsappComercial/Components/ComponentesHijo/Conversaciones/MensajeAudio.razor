@using System.IO

<div class="contenedor-audio">
    <audio controls preload="metadata" class="reproductor-audio">
        <source src="@ObtenerUrlWeb(RutaArchivo)" type="@ObtenerTipoMime(RutaArchivo)" />
        Tu navegador no soporta el reproductor de audio.
    </audio>

    @if (!string.IsNullOrEmpty(RutaArchivo))
    {
        <a href="@ObtenerUrlWeb(RutaArchivo)"
           download="@ObtenerNombreArchivo(RutaArchivo)"
           target="_blank"
           class="btn-descargar-audio"
           title="Descargar audio">
            <RadzenIcon Icon="download"></RadzenIcon>
        </a>
    }
</div>

<style>
    .contenedor-audio {
        display: flex;
        align-items: center;
        gap: 8px;
        max-width: 280px;
        padding: 2px 0;
    }

    .reproductor-audio {
        flex-grow: 1;
        max-width: 230px;
        height: 38px;
    }

    .btn-descargar-audio {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: rgba(0, 0, 0, 0.05);
        color: #54656f;
        font-size: 16px;
        text-decoration: none;
        transition: background-color 0.2s, color 0.2s;
        flex-shrink: 0;
    }

        .btn-descargar-audio:hover {
            background-color: rgba(0, 0, 0, 0.12);
            color: #111b21;
        }
</style>

@code {
    [Parameter] public string? RutaArchivo { get; set; }

    private string ObtenerUrlWeb(string? rutaFisica)
    {
        if (string.IsNullOrWhiteSpace(rutaFisica)) return string.Empty;

        // Si ya es una URL web o data URI, la dejamos pasar
        if (rutaFisica.StartsWith("/") || rutaFisica.StartsWith("http") || rutaFisica.StartsWith("data:"))
            return rutaFisica;

        // Si viene una ruta absoluta de Windows con wwwroot
        int indiceWwwroot = rutaFisica.IndexOf("wwwroot", StringComparison.OrdinalIgnoreCase);
        if (indiceWwwroot >= 0)
        {
            string relativa = rutaFisica.Substring(indiceWwwroot + 7);
            return relativa.Replace("\\", "/");
        }

        // Si viene con carpeta Multimedia
        int indiceMultimedia = rutaFisica.IndexOf("Multimedia", StringComparison.OrdinalIgnoreCase);
        if (indiceMultimedia >= 0)
        {
            string relativa = rutaFisica.Substring(indiceMultimedia);
            return "/" + relativa.Replace("\\", "/");
        }

        return rutaFisica.Replace("\\", "/");
    }

    private string ObtenerNombreArchivo(string? ruta)
    {
        if (string.IsNullOrWhiteSpace(ruta)) return "audio.ogg";

        string nombreOriginal = Path.GetFileName(ruta);

        // Si el archivo viene con extensión .webm, la forzamos a .ogg
        if (Path.GetExtension(nombreOriginal).Equals(".webm", StringComparison.OrdinalIgnoreCase))
        {
            return Path.ChangeExtension(nombreOriginal, ".ogg");
        }

        return nombreOriginal;
    }

    private string ObtenerTipoMime(string? ruta)
    {
        var extension = Path.GetExtension(ruta)?.ToLower();
        return extension switch
        {
            ".mp3" => "audio/mpeg",
            ".ogg" => "audio/ogg",
            ".wav" => "audio/wav",
            ".m4a" or ".aac" => "audio/mp4",
            ".opus" => "audio/ogg",
            _ => "audio/mpeg"
        };
    }
}