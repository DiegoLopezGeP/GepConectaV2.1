@using GepConecta.WhatsAppCloud.Models.Responses
@using WhatsappComercial.Components.ComponentesHijo.Conversaciones
@using WhatsappComercial.Modelos
@using WhatsappComercial.Modelos.DTOs
@inject TooltipService tooltipService
@inject DialogService dialogService

<RadzenCard Style="padding: 10px 15px; border-radius:12px; width: 100%; margin: 1% 0">

	@if (EsMovil)
	{
		<div class="encabezado-movil">
			<div class="info-conversacion">

				<div class="fila-superior">
					<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="width: 100%;">
						<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="width: 55%;">
							<div class="btn-atras" @onclick="Volver">
								<RadzenIcon Icon="arrow_back" />
							</div>
							<span class="ticket">
								Ticket: #@(datosContactoConversacion?.IdTicket.ToString() ?? "N/A")
							</span>
						</RadzenStack>

						<div class="acciones-movil">
							<RadzenStack Orientation="Orientation.Horizontal">

								<RadzenButton Icon="info"
											  Variant="Variant.Text"
											  ButtonStyle="ButtonStyle.Info"
											  Click="MostrarDetalles"
											  Size="ButtonSize.Medium"
											  MouseEnter="@(args => ShowTooltip(args, new TooltipOptions(){ Text = "Ver información" }))" />
								@if (informacionUsuarioAutenticado.IdGrupoTrabajo != 12)
								{
									<RadzenButton Icon="check_circle"
												  Variant="Variant.Text"
												  ButtonStyle="ButtonStyle.Danger"
												  Click="FinalizarConversacion"
												  MouseEnter="@(args => ShowTooltip(args, new TooltipOptions(){ Text = "Finalizar conversación" }))" />
								}
								

								<RadzenButton Icon="description"
											  ButtonStyle="ButtonStyle.Warning"
											  Variant="Variant.Text"
											  MouseEnter="@(args => ShowTooltip(args, new TooltipOptions(){ Text = "Mostrar Modal Plantillas" }))"
											  Click="AbrirPlantillasModal" />
							</RadzenStack>
						</div>
					</RadzenStack>
				</div>

				<div class="nombre-movil">
					@(datosContactoConversacion?.NombreCliente ?? "Sin Nombre")
				</div>

			</div>
		</div>
	}
	else
	{
		<div class="encabezado-conversacion">
			<RadzenText Text="Información de la conversación" TextStyle="TextStyle.H6" />
			@if (informacionUsuarioAutenticado.IdGrupoTrabajo == 12)
			{
				<RadzenButton Icon="check_circle"
							  Text="Finalizar"
							  ButtonStyle="ButtonStyle.Danger"
							  Variant="Variant.Outlined"
							  Click="FinalizarConversacion"
							  MouseEnter="@(args => ShowTooltip(args, new TooltipOptions(){ Text = "Pulse para finalizar la conversación" }))" />
			}
			
		</div>

		<RadzenRow Gap="20px">
			<RadzenColumn Size="12" SizeMD="5">
				<div class="campo-info">
					<label>Usuario</label>
					<RadzenText Text="@(datosContactoConversacion?.NombreCliente ?? "N/A")" />
				</div>

				<div class="campo-info">
					<label>Celular</label>
					<RadzenText Text="@(datosContactoConversacion?.Celular ?? "N/A")" />
				</div>
			</RadzenColumn>

			<RadzenColumn Size="12" SizeMD="4">
				<div class="campo-info">
					<label>Identificación</label>
					<RadzenText Text="@(datosContactoConversacion?.Identificacion ?? "N/A")" />
				</div>

				<div class="campo-info">
					<label>Estado / Ticket</label>
					<div class="estado-ticket">
						<span class="estado">@((datosContactoConversacion?.EstadoConversacion))</span>
						<span class="ticket">#@(datosContactoConversacion?.IdTicket.ToString() ?? "N/A")</span>
					</div>
				</div>
			</RadzenColumn>

			<RadzenColumn Size="12" SizeMD="3">
				<div class="campo-info">
					<label>Fecha inicio</label>
					<RadzenText Text="@(datosContactoConversacion?.FechaInicioConversacion?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")" />
				</div>

				<div class="campo-info">
					<label>Fecha finalización</label>
					<RadzenText Text="@(datosContactoConversacion?.FechaFinConversacion?.ToString("dd/MM/yyyy HH:mm") ?? "En curso")" />
				</div>
			</RadzenColumn>
		</RadzenRow>
	}
</RadzenCard>

<style>
	.encabezado-conversacion {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 10px;
	}

	.campo-info {
		margin-bottom: 15px;
	}

		.campo-info label {
			display: block;
			font-size: 13px;
			font-weight: 600;
			color: #6c757d;
			margin-bottom: 4px;
		}

	.estado-ticket {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 2px;
	}

	.estado {
		color: #198754;
		font-weight: 600;
	}

	.ticket {
		background: #0d6efd;
		color: white;
		padding: 2px 8px;
		border-radius: 10px;
		font-size: 12px;
		font-weight: 600;
		height: 25px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.encabezado-movil {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nombre-movil {
		font-size: 16px;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.acciones-movil {
		display: flex;
		gap: 5px;
	}

	.info-conversacion {
		flex: 1;
		min-width: 0;
	}

	.fila-superior {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 6px;
	}

	.btn-atras {
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 4px;
		border-radius: 50%;
	}
	/* Estilos específicos para el diálogo de finalizar conversación */
	.dialogo-finalizar-custom {
		border-radius: 12px !important;
		box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.15) !important;
	}

		/* Encabezado del modal */
		.dialogo-finalizar-custom .rz-dialog-titlebar {
			background-color: #f8f9fa;
			border-bottom: 1px solid #e9ecef;
			border-top-left-radius: 12px;
			border-top-right-radius: 12px;
			padding: 1rem 1.25rem;
			font-weight: 600;
			color: #212529;
		}

		/* Contenido del mensaje */
		.dialogo-finalizar-custom .rz-dialog-content {
			padding: 1.5rem;
			font-size: 0.95rem;
			color: #495057;
		}

		/* Pie del modal y contenedores de botones */
		.dialogo-finalizar-custom .rz-dialog-footer {
			padding: 1rem 1.25rem;
			border-top: 1px solid #e9ecef;
			background-color: #f8f9fa;
			border-bottom-left-radius: 12px;
			border-bottom-right-radius: 12px;
		}

			/* Botón de Confirmación (OkButton) */
			.dialogo-finalizar-custom .rz-button-primary,
			.dialogo-finalizar-custom .rz-dialog-footer button:last-child {
				background-color: #dc3545 !important; /* Rojo destructivo */
				border-color: #dc3545 !important;
				color: #ffffff !important;
				border-radius: 6px;
				font-weight: 600;
			}

				.dialogo-finalizar-custom .rz-button-primary:hover,
				.dialogo-finalizar-custom .rz-dialog-footer button:last-child:hover {
					background-color: #bb2d3b !important;
					border-color: #b02a37 !important;
				}

			/* Botón de Cancelar */
			.dialogo-finalizar-custom .rz-button-secondary,
			.dialogo-finalizar-custom .rz-dialog-footer button:first-child {
				background-color: #6c757d !important;
				border-color: #6c757d !important;
				color: #ffffff !important;
				border-radius: 6px;
			}

				.dialogo-finalizar-custom .rz-button-secondary:hover,
				.dialogo-finalizar-custom .rz-dialog-footer button:first-child:hover {
					background-color: #5c636a !important;
					border-color: #565e64 !important;
				}
</style>

	@code {
	[Parameter] public DatosContactoConversacionDTO? datosContactoConversacion { get; set; }
	[Parameter] public GrupoUser informacionUsuarioAutenticado { get; set; }
	[Parameter] public EventCallback OnVolver { get; set; }
	[Parameter] public EventCallback<int> OnFinalizarConversacion { get; set; }
	[Parameter] public bool EsMovil { get; set; }
	[Parameter] public List<PlantillaDTO> Plantillas { get; set; } = new();
	[Parameter] public PlantillaDTO? plantillaSeleccionada { get; set; }
	// EventCallback necesario para enviar la plantilla seleccionada al componente padre (Conversaciones)
	[Parameter] public EventCallback<(PlantillaMetaResponseDTO, PlantillaDTO)> OnUsarPlantilla { get; set; }



	void ShowTooltip(ElementReference elementReference, TooltipOptions options = null)
		=> tooltipService.Open(elementReference, options?.Text ?? "Pulse para finalizar la conversación!", options);

	private async Task FinalizarConversacion()
	{
		if (datosContactoConversacion is null) return;

		bool? confirmacion = await dialogService.Confirm(
			"¿Estás seguro de que deseas finalizar esta conversación?",
			"Finalizar Conversación",
			new ConfirmOptions()
			{
				OkButtonText = "Sí, Finalizar",
				CancelButtonText = "Cancelar",
				CssClass = "dialogo-finalizar-custom", 
				Style = "padding: 15px;"
				// Clase contenedora para personalizar
			});

		if (confirmacion == true)
		{
			await OnFinalizarConversacion.InvokeAsync(datosContactoConversacion.IdConversacion);
		}
	}

	private async Task MostrarDetalles()
	{
		await dialogService.OpenAsync<DetallesConversacionMovil>(
			"",
			new Dictionary<string, object?>
			{
				{ nameof(DetallesConversacionMovil.datosContactoConversacion), datosContactoConversacion }
			},
			new DialogOptions
			{
				Width = "90%",
				Style = "transform: translateY(100%); margin: 5%; border-radius: 10px; ",
				CloseDialogOnOverlayClick = true,
				ShowClose = true,
				ShowTitle = false
			});
	}

	private async Task AbrirPlantillasModal()
	{
		var opciones = new DialogOptions
		{
			Width = "90%",
			CloseDialogOnOverlayClick = true,
			ShowClose = true,
			Style = "margin-top: 10%; border-radius: 12px;",
			ShowTitle = false
		};

		await dialogService.OpenAsync<SelectorPlantillas>(
			"",
			new Dictionary<string, object?>
			{
				{ "Plantillas", Plantillas },
				{ "PlantillaSeleccionada", plantillaSeleccionada },
				{"conversacionSeleccionada", datosContactoConversacion },
				{ "PlantillaSeleccionadaChanged", EventCallback.Factory.Create<PlantillaDTO?>(this, (p) => {
					plantillaSeleccionada = p;
					StateHasChanged();
			})},

			{ "OnUsarPlantilla", EventCallback.Factory.Create<(PlantillaMetaResponseDTO, PlantillaDTO)>(this, async (detalleMeta) => {
				// 1. Primero se notifica al componente padre
				await OnUsarPlantilla.InvokeAsync(detalleMeta);

// 2. Al final se cierra el modal para evitar renderizar sobre un objeto descartado
				dialogService.Close();
			})}
			},
			opciones);
	}

	private async Task Volver()
	{
		await OnVolver.InvokeAsync();
	}
}