@using WhatsappComercial.Components.ComponentesHijo.Contactos
@using WhatsappComercial.Interfaces.Cache
@using WhatsappComercial.Modelos
@using WhatsappComercial.Modelos.DTOs
@inject DialogService dialogService
@inject ICacheConversaciones CacheConversaciones

<div class="panel-conversaciones">

	<!-- Acciones (Buscar cliente / Crear contacto) -->
	<div class="acciones-conversaciones">
		<RadzenStack Orientation="Orientation.Horizontal"
					 Gap="10px"
					 JustifyContent="@(esMovil ? JustifyContent.End : JustifyContent.Start)"
					 Style="background-color:white; padding:5px; border-radius: 10px;">
			<RadzenButton Icon="search"
						  Variant="Variant.Filled"
						  ButtonStyle="ButtonStyle.Info"
						  Style="width:50px;height:50px;border-radius:30px;"
						  Click="AbrirBusquedaCliente" />

			<RadzenButton Icon="add"
						  Variant="Variant.Filled"
						  ButtonStyle="ButtonStyle.Success"
						  Style="width:50px;height:50px;border-radius:30px;"
						  Click="AbrirRegistroContacto" />
		</RadzenStack>
	</div>

	<!-- Filtro de categorías (Chips con Badge dinámico) -->
	<div class="filtro-categorias">
		<RadzenStack Gap="0.5rem" Style="padding: 5px 0 10px 0;">
			<RadzenChipList @bind-Value="@selectedCategory"
							TValue="string"
							Data="@categories"
							ValueProperty="Name"
							TextProperty="Name"
							ChipStyle="BadgeStyle.Base"
							Change="OnFiltroBotonConversaciones">
				<Template Context="item">
					@{
						var categoria = item.Value as string;
					}
					<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px">
						<span>@categoria</span>
						@if (categoria == "No Leídos" && TotalConversacionesNoLeidas > 0)
						{
							<RadzenBadge BadgeStyle="BadgeStyle.Danger"
										 IsPill="true"
										 Text="@TotalConversacionesNoLeidas.ToString()"
										 Style="font-size: 11px; padding: 2px 6px;" />
						}
					</RadzenStack>
				</Template>
			</RadzenChipList>
		</RadzenStack>
	</div>

	<!-- Caja de Búsqueda -->
	<div class="caja-busqueda">
		<RadzenTextBox @bind-Value="TextoBusqueda"
					   Placeholder="Buscar por ticket o celular"
					   Style="width:100%; border-radius:10px; margin-bottom:10px;" />
	</div>

	<!-- Lista de tarjetas de conversación -->
	<div class="contenedor-tarjetas">
		<TarjetaConversacion datosTarjetaConversacion="@ListaDatosTarjetaFiltrada" OnSeleccionar="AbrirConversacion" />
	</div>
</div>

<style>
	.rz-dialog-content {
		padding: 0 !important
	}
	.rz-dialog-titlebar{
		padding: 0 !important
	}
</style>

@code {
	[Parameter] public EventCallback<DatosTarjetaConversacionDTO> OnAbrirConversacion { get; set; }
	[Parameter] public List<DatosTarjetaConversacionDTO> ListaDatosTarjeta { get; set; } = new();
	[Parameter] public string? NombreUsuarioDA { get; set; }
	[Parameter] public GrupoUser InformacionUsuarioAutenticado { get; set; } = new();
	[Parameter] public bool esMovil { get; set; }

	// NUEVO PARÁMETRO: Recibe el ID de la conversación que está abierta actualmente
	[Parameter] public int IdConversacionActiva { get; set; }

	private List<DatosTarjetaConversacionDTO> ListaDatosTarjetaFiltrada = new();
	private string textoBusqueda = string.Empty;

	string selectedCategory = "Activas";

	List<NamedItem> categories = new()
	{
		new NamedItem("Activas"),
		new NamedItem("No Leídos")
	};

	public record NamedItem(string Name);

	// El contador muestra solo las verdaderamente no leídas
	private int TotalConversacionesNoLeidas => ListaDatosTarjeta.Count(c => c.MensajesSinLeer > 0);

	private string TextoBusqueda
	{
		get => textoBusqueda;
		set
		{
			textoBusqueda = value;
			FiltrarConversaciones();
		}
	}

	protected override async Task OnParametersSetAsync()
	{
		FiltrarConversaciones();
	}

	private async Task AbrirBusquedaCliente()
	{
		var opciones = new DialogOptions
		{
			Width = esMovil ? "95% !important" : "40% !important",
			Resizable = true,
			CloseDialogOnOverlayClick = false,
			TitleContent = null,
			ShowClose = true,
			Style = esMovil ? "margin-top:60%; border-radius: 10px; padding: 0.7rem !important;" : null,
			ShowTitle = false

		};

		var result = await dialogService.OpenAsync<ConsultaContacto>(
			"Buscar Contacto",
			new Dictionary<string, object?>
			{
				{ "NombreUsuarioDA", NombreUsuarioDA },
				{ "InformacionUsuarioAutenticado", InformacionUsuarioAutenticado }, 
				{ "EsMovil", esMovil}
			},
			opciones);
	}

	private async Task AbrirRegistroContacto()
	{
		var opciones = new DialogOptions
		{
			Width = esMovil ? "95%!important" : "40% !important",
			CloseDialogOnOverlayClick = false,
			TitleContent = null,
			ShowClose = false,
			ShowTitle = false
		};

		if (esMovil)
		{
			opciones.Style = "margin-top:5%; border-radius: 10px; padding: 0.7rem !important;";
		}

		var result = await dialogService.OpenAsync<RegistroContacto>(
			"",
			new Dictionary<string, object>
			{
				{ nameof(RegistroContacto.grupoUser), InformacionUsuarioAutenticado },
				{ "EsMovil", esMovil}
			},
			opciones);
	}

	private void FiltrarConversaciones()
	{
		IEnumerable<DatosTarjetaConversacionDTO> resultado = ListaDatosTarjeta;

		// Si estamos en "No Leídos", incluimos las no leídas O la conversación actualmente seleccionada
		if (selectedCategory == "No Leídos")
		{
			resultado = resultado.Where(c => c.MensajesSinLeer > 0 || c.IdConversacion == IdConversacionActiva);
		}

		if (!string.IsNullOrWhiteSpace(textoBusqueda))
		{
			string filtro = textoBusqueda.Trim();

			resultado = resultado.Where(c =>
				(!string.IsNullOrWhiteSpace(c.NombreCliente) &&
					c.NombreCliente.Contains(filtro, StringComparison.OrdinalIgnoreCase))
				||
				c.IdTicket.ToString().Contains(filtro, StringComparison.OrdinalIgnoreCase));
		}

		ListaDatosTarjetaFiltrada = resultado.ToList();
	}

	private async Task OnFiltroBotonConversaciones()
	{
		FiltrarConversaciones();
		await InvokeAsync(StateHasChanged);
	}

	private async Task AbrirConversacion(DatosTarjetaConversacionDTO conversacion)
	{
		await OnAbrirConversacion.InvokeAsync(conversacion);
	}
}