@using System.Text.Encodings.Web
@using System.Text.RegularExpressions
@using System.Text.Json
@using GepConecta.WhatsAppCloud.Models.Responses
@using GepConecta.WhatsAppCloud.Services
@using WhatsappComercial.Interfaces.Plantillas
@using WhatsappComercial.Modelos.DTOs
@inject IWhatsAppCloudClient WhatsAppClient
@inject IObtenerParametrosPlantilla obtenerParametrosPlantilla

<div class="plantilla-contenedor-movil">
    <RadzenStack Gap="0.75rem" Style="width: 100%; padding: 10px;">
        <RadzenLabel Text="Seleccione Una Plantilla" Style="font-weight: bold; font-size: 14px;" />

        <RadzenDropDown TValue="PlantillaDTO"
                        Data="@Plantillas"
                        TextProperty="NombrePlantilla"
                        Placeholder="Seleccione una opción..."
                        AllowClear="true"
                        Style="width: 100%; border-radius: 8px;"
                        Value="@PlantillaSeleccionada"
                        Change="@OnSeleccionChanged" />

        <RadzenCard Class="card-vista-previa">
            @if (CargandoContenido)
            {
                <div class="estado-cargando">
                    <RadzenProgressBar Value="100" Mode="ProgressBarMode.Indeterminate" Style="width: 80%;" />
                    <RadzenText TextStyle="TextStyle.Caption">Consultando plantilla en Meta...</RadzenText>
                </div>
            }
            else if (PlantillaSeleccionada is not null)
            {
                <div class="contenido-plantilla">
                    <h5 class="titulo-plantilla">
                        @PlantillaSeleccionada.NombrePlantilla
                    </h5>

                    @if (DetallePlantillaMeta is not null)
                    {
                        @* 1. Header Imagen *@
                        @if (EsHeaderImagen && !string.IsNullOrEmpty(UrlImagenHeader))
                        {
                            <div class="header-imagen-container">
                                <img src="@UrlImagenHeader"
                                     alt="Encabezado de Plantilla"
                                     class="imagen-header-meta" />
                            </div>
                        }

                        @* 1.1 Header Texto *@
                        @if (HeaderComponente is not null && !string.IsNullOrEmpty(HeaderComponente.Texto))
                        {
                            <strong class="header-texto-meta">
                                @((MarkupString)FormatearTextoWhatsApp(HeaderComponente.Texto))
                            </strong>
                        }

                        @* 2. Body *@
                        <p class="body-texto-meta">
                            @((MarkupString)FormatearTextoWhatsApp(BodyTextoFormateado))
                        </p>

                        @* 3. Footer *@
                        @if (FooterComponente is not null && !string.IsNullOrEmpty(FooterComponente.Texto))
                        {
                            <small class="footer-texto-meta">
                                @((MarkupString)FormatearTextoWhatsApp(FooterComponente.Texto))
                            </small>
                        }

                        @* 4. Botones *@
                        @if (BotonesComponente?.Botones is not null && BotonesComponente.Botones.Any())
                        {
                            <hr class="separador-botones" />
                            <RadzenStack Gap="0.5rem">
                                @foreach (var boton in BotonesComponente.Botones)
                                {
                                    <RadzenButton Variant="Variant.Outlined"
                                                  ButtonStyle="ButtonStyle.Secondary"
                                                  Size="ButtonSize.Medium"
                                                  Text="@boton.Texto"
                                                  Class="boton-plantilla-preview"
                                                  Disabled="true" />
                                }
                            </RadzenStack>
                        }
                    }
                    else
                    {
                        <p class="body-texto-meta">
                            @((MarkupString)FormatearTextoWhatsApp(PlantillaSeleccionada.CuerpoMensaje))
                        </p>
                    }
                </div>
            }
            else
            {
                <div class="estado-vacio">
                    <RadzenText TextStyle="TextStyle.Body2">
                        <em>Seleccione una plantilla para ver su contenido aquí.</em>
                    </RadzenText>
                </div>
            }
        </RadzenCard>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Style="width: 100%;">
            <RadzenButton ButtonStyle="ButtonStyle.Primary"
                          Variant="Variant.Filled"
                          Shade="Shade.Default"
                          Text="Enviar Plantilla"
                          Icon="send"
                          Class="boton-enviar-movil"
                          Disabled="@(PlantillaSeleccionada is null || CargandoContenido)"
                          Click="@OnUsarPlantillaClick" />
        </RadzenStack>
    </RadzenStack>
</div>

