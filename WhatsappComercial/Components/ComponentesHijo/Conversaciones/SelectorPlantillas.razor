@code {
    [Parameter] public List<PlantillaDTO> Plantillas { get; set; } = new();
    [Parameter] public PlantillaDTO? PlantillaSeleccionada { get; set; }
    [Parameter] public EventCallback<PlantillaDTO?> PlantillaSeleccionadaChanged { get; set; }
    [Parameter] public DatosContactoConversacionDTO? conversacionSeleccionada { get; set; }
    [Parameter] public EventCallback<(PlantillaMetaResponseDTO, PlantillaDTO)> OnUsarPlantilla { get; set; }

    private PlantillaMetaResponseDTO? DetallePlantillaMeta { get; set; }
    private bool CargandoContenido { get; set; } = false;
    private string TextoCuerpoFormateado { get; set; } = string.Empty;

    private ComponentePlantillaDTO? HeaderComponente =>
        DetallePlantillaMeta?.Componentes?.FirstOrDefault(c => c.Tipo.Equals("HEADER", StringComparison.OrdinalIgnoreCase));

    private ComponentePlantillaDTO? BodyComponente =>
        DetallePlantillaMeta?.Componentes?.FirstOrDefault(c => c.Tipo.Equals("BODY", StringComparison.OrdinalIgnoreCase));

    private ComponentePlantillaDTO? FooterComponente =>
        DetallePlantillaMeta?.Componentes?.FirstOrDefault(c => c.Tipo.Equals("FOOTER", StringComparison.OrdinalIgnoreCase));

    private ComponentePlantillaDTO? BotonesComponente =>
        DetallePlantillaMeta?.Componentes?.FirstOrDefault(c => c.Tipo.Equals("BUTTONS", StringComparison.OrdinalIgnoreCase));

    private bool EsHeaderImagen =>
        HeaderComponente?.Ejemplo?.HeadersArchivos is not null &&
        HeaderComponente.Ejemplo.HeadersArchivos.Any();

    private string? UrlImagenHeader =>
        HeaderComponente?.Ejemplo?.HeadersArchivos?.FirstOrDefault();

    private string BodyTextoFormateado => string.IsNullOrEmpty(TextoCuerpoFormateado)
        ? (PlantillaSeleccionada?.CuerpoMensaje ?? string.Empty)
        : TextoCuerpoFormateado;

    private async Task OnSeleccionChanged(object value)
    {
        PlantillaSeleccionada = value as PlantillaDTO;
        DetallePlantillaMeta = null;
        TextoCuerpoFormateado = string.Empty;

        if (PlantillaSeleccionada is not null && !string.IsNullOrWhiteSpace(PlantillaSeleccionada.Id))
        {
            CargandoContenido = true;
            StateHasChanged();

            try
            {
                DetallePlantillaMeta = await WhatsAppClient.ObtenerContenidoPlantillaAsync(PlantillaSeleccionada.Id);
                var parametrosPlantillas = await obtenerParametrosPlantilla.ObtenerParametrosPlantilla(PlantillaSeleccionada.Id, conversacionSeleccionada);

                // Mantenemos el texto base intacto con sus {1}, {2} sin alterar
                string textoBase = BodyComponente?.Texto ?? PlantillaSeleccionada.CuerpoMensaje ?? string.Empty;

                // Aplicar reemplazo de parámetros de la BD/Objeto
                if (parametrosPlantillas is not null)
                {
                    textoBase = ReemplazarParametrosEnTexto(textoBase, parametrosPlantillas, DetallePlantillaMeta);
                }

                TextoCuerpoFormateado = textoBase;
                PlantillaSeleccionada.CuerpoMensaje = TextoCuerpoFormateado;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ERROR AL OBTENER PLANTILLA]: {ex.Message}");
                TextoCuerpoFormateado = PlantillaSeleccionada.CuerpoMensaje ?? string.Empty;
            }
            finally
            {
                CargandoContenido = false;
            }
        }

        await PlantillaSeleccionadaChanged.InvokeAsync(PlantillaSeleccionada);
        StateHasChanged();
    }

    private async Task OnUsarPlantillaClick()
    {
        if (PlantillaSeleccionada is not null)
        {
            if (!string.IsNullOrEmpty(TextoCuerpoFormateado))
            {
                PlantillaSeleccionada.CuerpoMensaje = TextoCuerpoFormateado;
            }

            await OnUsarPlantilla.InvokeAsync((DetallePlantillaMeta ?? new PlantillaMetaResponseDTO(), PlantillaSeleccionada));
        }
    }

    private string ReemplazarParametrosEnTexto(string textoBase, object? parametros, PlantillaMetaResponseDTO? plantillaMetaResponseDTO)
    {
        if (string.IsNullOrWhiteSpace(textoBase) || parametros is null)
            return textoBase;

        try
        {
            Dictionary<string, string> mapaParametros = new(StringComparer.OrdinalIgnoreCase);
            List<string> listaValoresOrdenados = new();

            // 1. Extraer claves y valores del objeto/diccionario 'parametros'
            if (parametros is IEnumerable<Dictionary<string, object?>> listaDict)
            {
                var primerRegistro = listaDict.FirstOrDefault();
                if (primerRegistro != null)
                {
                    foreach (var kvp in primerRegistro)
                    {
                        string val = kvp.Value?.ToString() ?? string.Empty;
                        mapaParametros[kvp.Key] = val;
                        listaValoresOrdenados.Add(val);
                    }
                }
            }
            else if (parametros is Dictionary<string, object?> dictObjeto)
            {
                foreach (var kvp in dictObjeto)
                {
                    string val = kvp.Value?.ToString() ?? string.Empty;
                    mapaParametros[kvp.Key] = val;
                    listaValoresOrdenados.Add(val);
                }
            }
            else
            {
                var json = JsonSerializer.Serialize(parametros);
                using var doc = JsonDocument.Parse(json);

                if (doc.RootElement.ValueKind == JsonValueKind.Array && doc.RootElement.GetArrayLength() > 0)
                {
                    var primerElemento = doc.RootElement[0];
                    foreach (var prop in primerElemento.EnumerateObject())
                    {
                        string val = prop.Value.ToString();
                        mapaParametros[prop.Name] = val;
                        listaValoresOrdenados.Add(val);
                    }
                }
                else if (doc.RootElement.ValueKind == JsonValueKind.Object)
                {
                    foreach (var prop in doc.RootElement.EnumerateObject())
                    {
                        string val = prop.Value.ToString();
                        mapaParametros[prop.Name] = val;
                        listaValoresOrdenados.Add(val);
                    }
                }
            }

            // 2. Asignar también los índices numéricos (1, 2, 3...) según el orden
            for (int i = 0; i < listaValoresOrdenados.Count; i++)
            {
                string posicion = (i + 1).ToString();
                if (!mapaParametros.ContainsKey(posicion))
                {
                    mapaParametros[posicion] = listaValoresOrdenados[i];
                }
            }

            string textoResultado = textoBase;

            // 3. Reemplazar sobre el texto original
            foreach (var param in mapaParametros)
            {
                string claveEscapada = Regex.Escape(param.Key);
                string valor = param.Value;

                // Soporta {1}, {{1}}, [1], {Nombre}, {{Nombre}}, etc.
                textoResultado = Regex.Replace(textoResultado, $@"\{{\{{\s*{claveEscapada}\s*\}}\}}", valor, RegexOptions.IgnoreCase);
                textoResultado = Regex.Replace(textoResultado, $@"\{{\s*{claveEscapada}\s*\}}", valor, RegexOptions.IgnoreCase);
                textoResultado = Regex.Replace(textoResultado, $@"\[\[\s*{claveEscapada}\s*\]\]", valor, RegexOptions.IgnoreCase);
                textoResultado = Regex.Replace(textoResultado, $@"\[\s*{claveEscapada}\s*\]", valor, RegexOptions.IgnoreCase);
            }

            return textoResultado;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR REEMPLAZANDO PARÁMETROS]: {ex.Message}");
            return textoBase;
        }
    }

    private string FormatearTextoWhatsApp(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto))
            return string.Empty;

        string htmlEscaped = HtmlEncoder.Default.Encode(texto);

        htmlEscaped = Regex.Replace(htmlEscaped, @"```(.*?)```", "<code>$1</code>", RegexOptions.Singleline);
        htmlEscaped = Regex.Replace(htmlEscaped, @"\*_([^*_]+)_\*", "<strong><em>$1</em></strong>");
        htmlEscaped = Regex.Replace(htmlEscaped, @"_\*([^*_]+)\*_", "<em><strong>$1</strong></em>");
        htmlEscaped = Regex.Replace(htmlEscaped, @"(?<=\s|^|\W)\*([^\*]+)\*(?=\s|$|\W)", "<strong>$1</strong>");
        htmlEscaped = Regex.Replace(htmlEscaped, @"(?<=\s|^|\W)_([^_]+)_(?=\s|$|\W)", "<em>$1</em>");
        htmlEscaped = Regex.Replace(htmlEscaped, @"(?<=\s|^|\W)~([^~]+)~(?=\s|$|\W)", "<del>$1</del>");
        htmlEscaped = Regex.Replace(htmlEscaped, @"`([^`]+)`", "<code>$1</code>");

        return htmlEscaped;
    }
}