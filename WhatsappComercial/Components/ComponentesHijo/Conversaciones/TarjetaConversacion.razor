@using WhatsappComercial.Interfaces.Cache
@using WhatsappComercial.Modelos.DTOs
@inject ICacheConversaciones cacheConversaciones

@foreach (var item in datosTarjetaConversacion)
{
	bool estaSeleccionada = tarjetaSeleccionada?.IdConversacion == item.IdConversacion;

	<RadzenCard Style="@ObtenerEstiloTarjeta(estaSeleccionada)"
				class="@(estaSeleccionada ? "tarjeta-conversacion seleccionada" : "tarjeta-conversacion")"
				@onclick="() => SeleccionarTarjeta(item)">

		<div class="ticket-superior">

			@if (item.esNuevaConversacion)
			{
				<span class="marca-nueva">
					Nueva
				</span>
			}

			<span class="ticket-badge">
				Ticket #@item.IdTicket
			</span>

		</div>

		<div class="contenido-conversacion">

			<RadzenImage Path="Images/Hombre.jpg"
						 Style="width: 60px; height: 60px; border-radius: 50%; flex-shrink: 0;" />

			<div class="datos-conversacion">

				<div class="nombre-cliente">
					@item.NombreCliente
				</div>

				<div class="pie-conversacion">
					<span>@item.Fecha?.ToString("dd/MM/yyyy h:mm tt")</span>

					<span class="estado">
						@item.EstadoConversacion
					</span>
				</div>

			</div>

		</div>

	</RadzenCard>
}


@code {
	[Parameter] public List<DatosTarjetaConversacionDTO> datosTarjetaConversacion { get; set; } = new();
	[Parameter] public EventCallback<DatosTarjetaConversacionDTO> OnSeleccionar { get; set; }

	// Variable para realizar el seguimiento del ítem seleccionado
	private DatosTarjetaConversacionDTO? tarjetaSeleccionada;

	private async Task SeleccionarTarjeta(DatosTarjetaConversacionDTO tarjeta)
	{
		tarjetaSeleccionada = tarjeta;

		if (tarjeta.esNuevaConversacion)
		{
			tarjeta.esNuevaConversacion = false;
			// Implementar actualización de cache:
			// await cacheConversaciones.CrearOActualizarAsync(tarjeta);
		}

		await OnSeleccionar.InvokeAsync(tarjeta);
	}

	private string ObtenerEstiloTarjeta(bool seleccionada)
	{
		var baseStyle = "margin-bottom: 5px; border-radius: 12px; padding: 12px; cursor: pointer; transition: all 0.2s ease-in-out;";

		if (seleccionada)
		{
			// Borde izquierdo o completo de color primario, fondo activo y sombra
			return $"{baseStyle} border-left: 5px solid var(--rz-primary, #056162); background-color: var(--rz-primary-lighter, #e7f1f1); box-shadow: 0 4px 10px rgba(0,0,0,0.12);";
		}

		return $"{baseStyle} border: 1px solid #e0e0e0;";
	}
}