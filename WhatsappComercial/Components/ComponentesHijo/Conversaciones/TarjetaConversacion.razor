@using WhatsappComercial.Modelos.DTOs

@foreach (var item in datosTarjetaConversacion)
{
	<RadzenCard Style="margin-bottom: 5px; border-radius: 12px; padding: 12px; cursor: pointer;" @onclick="() => SeleccionarTarjeta(item)">

		<div class="ticket-superior">

			@if (item.esNuevaConversacion)
			{
				<span class="marca-nueva">
					Nueva
				</span>
			}

			<span class="ticket-badge">
				Ticket #@item.IdTicket
			</span>

		</div>

		<div class="contenido-conversacion">

			<RadzenImage Path="Images/Hombre.jpg"
						 Style="    width: 60px; height: 60px; border-radius: 50%; flex-shrink: 0;" />

			<div class="datos-conversacion">

				<div class="nombre-cliente">
					@item.NombreCliente
				</div>

				<div class="pie-conversacion">
					<span>@item.Fecha?.ToString("dd/MM/yyyy h:mm tt")</span>

					<span class="estado">
						@item.EstadoConversacion
					</span>
				</div>

			</div>

		</div>

	</RadzenCard>
}


@code {
	[Parameter] public List<DatosTarjetaConversacionDTO> datosTarjetaConversacion { get; set; } = new();
	[Parameter] public EventCallback<DatosTarjetaConversacionDTO> OnSeleccionar { get; set; }

	private async Task SeleccionarTarjeta(DatosTarjetaConversacionDTO tarjeta)
	{
		if (tarjeta.esNuevaConversacion)
			tarjeta.esNuevaConversacion = false;
		await OnSeleccionar.InvokeAsync(tarjeta);
	}
}

