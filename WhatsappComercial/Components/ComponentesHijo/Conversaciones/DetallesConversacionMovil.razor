@using WhatsappComercial.Modelos.DTOs
<RadzenStack Gap="15px" Style="margin: 30px 15px;">

    <RadzenText Text="@datosContactoConversacion.NombreCliente" TextStyle="TextStyle.H6"/>

    <RadzenText>
        <strong>Identificación:</strong> @datosContactoConversacion.Identificacion
    </RadzenText>

    <RadzenText>
        <strong>Celular:</strong> @datosContactoConversacion.Celular
    </RadzenText>

    <RadzenText>
        <strong>Estado:</strong> @datosContactoConversacion.EstadoConversacion
    </RadzenText>

    <RadzenText>
        <strong>Ticket:</strong> #@datosContactoConversacion.IdTicket
    </RadzenText>

    <RadzenText>
        <strong>Fecha inicio:</strong> @datosContactoConversacion.FechaInicioConversacion?.ToString("dd/MM/yyyy HH:mm")
    </RadzenText>

    <RadzenText>
        <strong>Fecha finalización:</strong>
        @(datosContactoConversacion.FechaFinConversacion?.ToString("dd/MM/yyyy HH:mm") ?? "En curso")
    </RadzenText>

</RadzenStack>

@code{


    [Parameter] public DatosContactoConversacionDTO datosContactoConversacion { get; set; }
}