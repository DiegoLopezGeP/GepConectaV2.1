<RadzenStack Gap="15px" Style="margin: 30px 15px;">

    <RadzenText Text="@Usuario" TextStyle="TextStyle.H6"/>

    <RadzenText>
        <strong>Identificación:</strong> @Identificacion
    </RadzenText>

    <RadzenText>
        <strong>Celular:</strong> @Celular
    </RadzenText>

    <RadzenText>
        <strong>Estado:</strong> @Estado
    </RadzenText>

    <RadzenText>
        <strong>Ticket:</strong> #@IdTicket
    </RadzenText>

    <RadzenText>
        <strong>Fecha inicio:</strong> @FechaInicio.ToString("dd/MM/yyyy HH:mm")
    </RadzenText>

    <RadzenText>
        <strong>Fecha finalización:</strong>
        @(FechaFinalizacion?.ToString("dd/MM/yyyy HH:mm") ?? "En curso")
    </RadzenText>

</RadzenStack>

@code{
    [Parameter] public string Usuario { get; set; } = "";
    [Parameter] public string Celular { get; set; } = "";
    [Parameter] public string Identificacion { get; set; } = "";
    [Parameter] public string Estado { get; set; } = "";
    [Parameter] public DateTime FechaInicio { get; set; }
    [Parameter] public DateTime? FechaFinalizacion { get; set; }
    [Parameter] public string IdTicket { get; set; } = "";
}